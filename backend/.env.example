# Copy to backend/.env and fill in real values. Never commit the real .env file.
# This single service runs both the admin API and the ingestion/generation/publishing
# worker cycle (on an in-process scheduler) — one process, one env file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=post-images
# Admin login tokens are verified against Supabase's public JWKS
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) — no separate secret needed.

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://news.netlify.app

# slowapi rate limit syntax, e.g. "100/minute"
RATE_LIMIT_DEFAULT=100/minute

# --- AI text (free: Groq free tier) ---
# Groq model with JSON mode support. See https://console.groq.com/docs/models
TEXT_MODEL=llama-3.3-70b-versatile
# Fallback used only if no Groq credential is configured in the admin dashboard's
# credentials table (provider=groq, key_name=api_key). Get a free key at
# https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=replace-with-groq-api-key
# Optional same-day fallback used only when Groq's daily cap is hit — text generation
# falls back to Gemini instead of leaving the article for a later cycle. Free key (no
# card required): https://aistudio.google.com/apikey. Fallback env var used only if no
# Gemini credential is configured in the admin dashboard (provider=gemini, key_name=api_key).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash

# --- Images: 3-tier fallback, first one available wins ---
# 1. The source publisher's own article image (extracted from RSS at ingestion time, no config needed)
# 2. Unsplash, searched by the story's main keyword — optional but recommended. Free key:
#    https://unsplash.com/developers -> New Application -> Access Key. Fallback env var used only
#    if no Unsplash credential is configured in the admin dashboard (provider=unsplash, key_name=access_key).
UNSPLASH_ACCESS_KEY=replace-with-unsplash-access-key
# 3. Pollinations.ai AI-generated image (free, no API key needed) — last resort, nothing to set here.

# --- Notifications (fallbacks; prefer configuring from the admin dashboard) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_WEBHOOK_URL=

REQUEST_TIMEOUT_SECONDS=30
# How often the in-process scheduler runs an ingest/generate/publish cycle.
# A full cycle (up to max_articles_per_run articles, each paced ~3s apart for
# Pollinations' rate limit) can take 10-15+ min — keep this comfortably above
# that or the scheduler will skip a tick rather than overlap runs.
LOOP_INTERVAL_MINUTES=20
