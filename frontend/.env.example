# Copy to frontend/.env.local and fill in real values. Never commit the real .env.local file.
# All NEXT_PUBLIC_* values are shipped to the browser — only put values here that are safe to
# be public. The Supabase ANON key is designed to be public; Row Level Security protects the data.

NEXT_PUBLIC_SUPABASE_URL=https://lslslmvhwknghwqieeck.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-public-key

# Public URL of the deployed backend (FastAPI admin API), e.g. https://news-backend.onrender.com
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
